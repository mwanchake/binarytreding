FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY scripts/tradingview-websocket-proxy.js scripts/tradingview-websocket-proxy.js

ENV NODE_ENV=production
ENV PORT=10000
EXPOSE 10000

CMD ["node", "scripts/tradingview-websocket-proxy.js"]
